<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Bonfire.Service</RootNamespace>
    <AssemblyName>BonfireService</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>false</UseWindowsForms>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <BonfireVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\VERSION').Trim())</BonfireVersion>
    <Version>$(BonfireVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Track C Phase 2A: embed the Paramdex-derived DS2 item-id ↔ name
       table so the bridge.status RPC can resolve weapon/armor IDs
       server-side. ~60 KB JSON, ~1850 entries. Built from
       Paramdex/DS2S/Names/{ItemParam,WeaponParam,ArmorParam}.txt — see
       Tools/build_ds2_item_names.py (one-shot generator). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\ds2_item_names.json">
      <LogicalName>Bonfire.Service.Resources.ds2_item_names.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Reuse the proven Win32 / Steam / patching code from the original Loader.
       Each file ships under namespace `Loader` and is pure logic (no WinForms
       refs). We link it with <Link> so Visual Studio shows them grouped under
       a single virtual folder. -->
  <ItemGroup>
    <Compile Include="..\Loader\Utils\WinAPI.cs"          Link="External\WinAPI.cs" />
    <Compile Include="..\Loader\Utils\ExeUtils.cs"        Link="External\ExeUtils.cs" />
    <Compile Include="..\Loader\Utils\EncryptionUtils.cs" Link="External\EncryptionUtils.cs" />
    <Compile Include="..\Loader\Utils\PatchingUtils.cs"   Link="External\PatchingUtils.cs" />
    <Compile Include="..\Loader\Utils\SteamUtils.cs"      Link="External\SteamUtils.cs" />
    <Compile Include="..\Loader\Utils\NetUtils.cs"        Link="External\NetUtils.cs" />
    <Compile Include="..\Loader\Config\BuildConfig.cs"    Link="External\BuildConfig.cs" />
    <Compile Include="..\Loader\Config\Ds2ModEngineSettings.cs" Link="External\Ds2ModEngineSettings.cs" />
    <Compile Include="..\Loader\Config\InjectionConfig.cs" Link="External\InjectionConfig.cs" />
    <Compile Include="..\Loader\Config\ServerConfig.cs"   Link="External\LoaderServerConfig.cs" />
  </ItemGroup>

</Project>
